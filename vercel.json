{
  "version": 2,
  "rewrites": [
    {
      "source": "/submit-event",
      "destination": "/submit-event.html"
    },
    {
      "source": "/for-organisations",
      "destination": "/for-organisations.html"
    },
    {
      "source": "/activities",
      "destination": "/activities.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
