{
  "version": 2,
  "rewrites": [
    {
      "source": "/submit-event",
      "destination": "/submit-event.html"
    },
    {
      "source": "/for-organisations",
      "destination": "/for-organisations.html"
    },
    {
      "source": "/activities",
      "destination": "/activities.html"
    },
    {
      "source": "/submit-listing",
      "destination": "/submit-listing.html"
    },
    {
      "source": "/admin/listings",
      "destination": "/admin-listings.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/accessibility",
      "destination": "/accessibility.html"
    },
    {
      "source": "/corrections",
      "destination": "/corrections.html"
    },
    {
      "source": "/admin/events",
      "destination": "/event-catalogue-admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/event-collector?source=experience",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/event-collector?source=wx",
      "schedule": "3 5 * * *"
    },
    {
      "path": "/api/event-collector?source=museums",
      "schedule": "6 5 * * *"
    },
    {
      "path": "/api/event-collector?source=hepworth",
      "schedule": "9 5 * * *"
    },
    {
      "path": "/api/event-collector?source=ncm",
      "schedule": "12 5 * * *"
    },
    {
      "path": "/api/event-collector?source=ysp",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/event-collector?source=cathedral",
      "schedule": "18 5 * * *"
    },
    {
      "path": "/api/event-collector?source=theatre",
      "schedule": "21 5 * * *"
    },
    {
      "path": "/api/event-collector?source=arthouse",
      "schedule": "24 5 * * *"
    },
    {
      "path": "/api/event-collector?source=nostell",
      "schedule": "27 5 * * *"
    },
    {
      "path": "/api/event-collector?source=fairburn",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/event-collector?source=blacker-hall",
      "schedule": "33 5 * * *"
    },
    {
      "path": "/api/event-collector?source=copleys",
      "schedule": "36 5 * * *"
    },
    {
      "path": "/api/event-collector?source=libraries",
      "schedule": "39 5 * * *"
    },
    {
      "path": "/api/event-collector?source=races",
      "schedule": "42 5 * * *"
    }
  ],
  "functions": {
    "api/event-collector.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ask-wakefield.vercel.app"
        }
      ],
      "destination": "https://www.askwakefield.co.uk/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin-listings.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/event-catalogue-admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
